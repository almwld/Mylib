                        "uk": "\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0454\u043c\u043e Image 2.0",
                        "ur-IN": "Image 2.0 \u067e\u06cc\u0634 \u06c1\u06d2",
                        "vi": "Gi\u1edbi thi\u1ec7u Image 2.0",
