                        "te": "\u0c35\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c47 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41",
                        "th": "\u0e02\u0e49\u0e2d\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e17\u0e35\u0e48\u0e43\u0e0a\u0e49\u0e1a\u0e31\u0e07\u0e04\u0e31\u0e1a",
