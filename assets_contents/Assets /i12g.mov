                        "uk": "\u0417\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u043d\u0456 \u0443\u043c\u043e\u0432\u0438",
                        "ur-IN": "\u0644\u0627\u06af\u0648 \u0634\u0631\u0627\u0626\u0637",
